diff --git a/firmware/hw_layer/g0_extension/README.md b/firmware/hw_layer/g0_extension/README.md
index 86803702dc..aaabbf64f2 100644
--- a/firmware/hw_layer/g0_extension/README.md
+++ b/firmware/hw_layer/g0_extension/README.md
@@ -1,6 +1,7 @@
-G0 expansion support is split into six commits: protocol/link, SPI transport,
-ADC, digital inputs, outputs/PWM, and firmware bundling/updater. Each commit
-includes its tests and only depends on the preceding parts.
+G0 expansion support is split into six modules: protocol/link, SPI transport,
+ADC, digital inputs, outputs/PWM, and firmware bundling/updater. Each part
+includes its tests and only depends on the preceding parts. The updater branch
+also contains the factory-provisioning follow-up.
 
 The link uses the shared protocol-9 header from dynfer/g0-extension: 36-byte frames,
 CRC16/CCITT-FALSE in bytes 34..35, and a response delayed by one exchange. It
@@ -48,12 +49,38 @@ and generates `g0_firmware_image.h` containing the complete immutable image and
 build identity. Clean builds recreate it; unchanged inputs preserve timestamps.
 No prepared binary/header is needed. Update the submodule pin for a new release.
 
-Before registering remote I/O, the updater compares protocol and image identity.
-If they differ, it enters ROM using BOOT/RESET, writes padded 256-byte blocks,
-reads every block back, resets and checks the identity again. Invalid vectors or
-images beyond G071 flash bounds are rejected before resetting hardware. Firmware
-identity is generated from the companion build inputs; it is independent of the
-wire protocol version. Updating protocol-8 firmware uses the same ROM path.
+Before registering remote I/O, the updater first probes an existing G071 ROM
+session without pulsing NRST. This preserves factory-blank entry on ROM versions
+that clear the EMPTY flag during startup. RESET and BOOT output latches are
+preloaded high before enabling their GPIO drivers. Atlas also keeps PB14/NRST
+pulled up during both ECU bootloader and main-firmware GPIO initialization. A running application follows
+the normal reset/version-check path; a matching image skips programming.
+
+Before erasing main flash, the loader confirms device ID 0x0460, reads the full
+128-byte option block twice, and validates its option/complement pairs. It
+requires RDP level 0, nBOOT1=1, BOOT_LOCK=0 and an NRST input mode. If nBOOT_SEL is
+set, it clears only that bit and updates its inverse copy, preserving all other
+bytes. An already enabled BOOT0 pin causes no option write. The loader reconnects
+after the write and verifies the complete option block; a missing final ACK is
+accepted only when the readback proves the intended configuration was stored.
+
+It then programs padded 256-byte blocks and reads every block back. BOOT0 is
+lowered before the ROM Go command starts the application, avoiding dependence on
+the latched EMPTY flag. The application protocol and image identity must match
+before runtime I/O is registered. Invalid vectors or images beyond G071 flash
+bounds are rejected before changing hardware. Firmware identity is generated
+from companion build inputs independently of the wire protocol version.
+
+This first-boot path needs a live ROM session from power-on. A G0 that already
+lost that session while BOOT0 selection was disabled may need a full power cycle;
+pulsing NRST cannot recreate the empty-check condition on affected ROMs. An
+already programmed chip with BOOT0 disabled still needs a cooperating application
+or debug access to enter ROM.
+
+The option layout and boot sequence follow
+[RM0444](https://www.stmcu.jp/wp/wp-content/uploads/2018/12/RM0444_Rev3.pdf),
+[AN2606 section 48.3.1](https://www.st.com/resource/en/application_note/an2606-stm32-microcontroller-system-memory-boot-mode-stmicroelectronics.pdf#page=264)
+and [AN4286](https://www.st.com/resource/en/application_note/an4286-spi-protocol-used-in-the-stm32-bootloader-stmicroelectronics.pdf).
 
 `G0_FIRMWARE_UPDATE=no` builds runtime I/O without an image or updater.
 `G0_EXTENSION=no` disables the expansion. These flags also skip the companion
diff --git a/firmware/hw_layer/g0_extension/bootloader.cpp b/firmware/hw_layer/g0_extension/bootloader.cpp
index c066a8acfe..000959aef7 100644
--- a/firmware/hw_layer/g0_extension/bootloader.cpp
+++ b/firmware/hw_layer/g0_extension/bootloader.cpp
@@ -42,10 +42,28 @@ bool Bootloader::ack(uint32_t timeoutMs) {
 	return false;
 }
 
-bool Bootloader::command(uint8_t command) {
+bool Bootloader::command(uint8_t command, uint32_t timeoutMs) {
 	const uint8_t packet[] = {0x5a, command, uint8_t(command ^ 0xff)};
 	send(packet, sizeof(packet));
-	return ack();
+	return ack(timeoutMs);
+}
+
+bool Bootloader::connect() {
+	m_connected = false;
+	m_io.byte(0x5a);
+	// An already synchronized ROM can NACK the sync byte; Get ID confirms the session.
+	ack(100);
+	if (!command(0x02, 100)) {
+		return false;
+	}
+	m_io.byte(0); // Receive-data BUSY byte.
+	if (m_io.byte(0) != 1) {
+		return false;
+	}
+	uint16_t id = uint16_t(m_io.byte(0)) << 8;
+	id |= m_io.byte(0);
+	m_connected = ack(100) && id == 0x0460; // STM32G07x/08x, RM0444 option layout.
+	return m_connected;
 }
 
 bool Bootloader::address(uint32_t address) {
@@ -55,33 +73,52 @@ bool Bootloader::address(uint32_t address) {
 	return ack();
 }
 
-bool Bootloader::write(uint32_t location, const uint8_t* data) {
-	if (!command(0x31) || !address(location)) {
+bool Bootloader::write(uint32_t location, const uint8_t* data, size_t size) {
+	if (size == 0 || size > 256 || size % 8 || !command(0x31) || !address(location)) {
 		return false;
 	}
-	uint8_t checksum = 255;
-	m_io.byte(255);
-	for (size_t i = 0; i < 256; i++) {
+	uint8_t checksum = uint8_t(size - 1);
+	m_io.byte(checksum);
+	for (size_t i = 0; i < size; i++) {
 		m_io.byte(data[i]);
 		checksum ^= data[i];
 	}
 	m_io.byte(checksum);
-	m_io.sleepMs(10); // Allow programming to finish before polling.
-	return ack();
+	if (location != OptionsBase) {
+		m_io.sleepMs(10); // Allow main-flash programming to finish before polling.
+	}
+	return ack(location == OptionsBase ? 100 : 1000);
 }
 
-bool Bootloader::verify(uint32_t location, const uint8_t* data) {
-	if (!command(0x11) || !address(location)) {
+bool Bootloader::startRead(uint32_t location, size_t size) {
+	if (size == 0 || size > 256 || !command(0x11) || !address(location)) {
 		return false;
 	}
-	const uint8_t length[] = {255, 0};
+	const uint8_t length[] = {uint8_t(size - 1), uint8_t((size - 1) ^ 0xff)};
 	send(length, sizeof(length));
 	if (!ack()) {
 		return false;
 	}
 	m_io.byte(0); // Receive-data BUSY byte.
+	return true;
+}
+
+bool Bootloader::read(uint32_t location, uint8_t* data, size_t size) {
+	if (!startRead(location, size)) {
+		return false;
+	}
+	for (size_t i = 0; i < size; i++) {
+		data[i] = m_io.byte(0);
+	}
+	return true;
+}
+
+bool Bootloader::verify(uint32_t location, const uint8_t* data, size_t size) {
+	if (!startRead(location, size)) {
+		return false;
+	}
 	bool matches = true;
-	for (size_t i = 0; i < 256; i++) {
+	for (size_t i = 0; i < size; i++) {
 		if (m_io.byte(0) != data[i]) {
 			matches = false;
 		}
@@ -89,12 +126,41 @@ bool Bootloader::verify(uint32_t location, const uint8_t* data) {
 	return matches;
 }
 
+bool Bootloader::enableBootPin() {
+	uint8_t options[OptionsSize];
+	if (!read(OptionsBase, options, sizeof(options)) || !verify(OptionsBase, options, sizeof(options))) {
+		return false;
+	}
+	// RM0444: seven option pairs at +0x00..0x30 and SECR at +0x70; the rest is reserved.
+	static constexpr uint8_t offsets[] = {0, 8, 16, 24, 32, 40, 48, 112};
+	for (auto offset : offsets) {
+		if ((little32(options + offset) ^ little32(options + offset + 4)) != 0xffffffffU) {
+			return false;
+		}
+	}
+	const uint32_t user = little32(options);
+	const uint32_t nrstMode = (user >> 27) & 3;
+	if ((user & 0xff) != 0xaa || !(user & (1U << 25)) || (little32(options + 112) & (1U << 16)) ||
+		(nrstMode != 1 && nrstMode != 3)) {
+		return false;
+	}
+	if (!(user & (1U << 24))) {
+		return true;
+	}
+	options[3] &= ~1U; // nBOOT_SEL and its complemented copy; preserve every other option bit.
+	options[7] |= 1U;
+	// Reload can interrupt the final ACK; only reconnect and full readback establish success.
+	write(OptionsBase, options, sizeof(options));
+	m_connected = false;
+	m_io.reconnect();
+	return connect() && verify(OptionsBase, options, sizeof(options));
+}
+
 bool Bootloader::flash(const uint8_t* image, size_t size) {
 	if (!validImage(image, size)) {
 		return false;
 	}
-	m_io.byte(0x5a);
-	if (!ack() || !command(0x44)) {
+	if ((!m_connected && !connect()) || !enableBootPin() || !command(0x44)) {
 		return false;
 	}
 	const uint8_t erase[] = {255, 255, 0};
@@ -107,11 +173,14 @@ bool Bootloader::flash(const uint8_t* image, size_t size) {
 		std::memset(block, 255, sizeof(block));
 		const size_t count = size - offset < 256 ? size - offset : 256;
 		std::memcpy(block, image + offset, count);
-		if (!write(FlashBase + offset, block) || !verify(FlashBase + offset, block)) {
+		if (!write(FlashBase + offset, block, sizeof(block)) || !verify(FlashBase + offset, block, sizeof(block))) {
 			return false;
 		}
 	}
-	// The board resets into the application after deselecting SPI.
 	return true;
 }
+
+bool Bootloader::go() {
+	return m_connected && command(0x21) && address(FlashBase);
+}
 } // namespace g0
