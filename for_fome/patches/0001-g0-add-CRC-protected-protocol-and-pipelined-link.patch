diff --git a/firmware/hw_layer/g0_extension/README.md b/firmware/hw_layer/g0_extension/README.md
new file mode 100644
index 0000000000..13458c55bf
--- /dev/null
+++ b/firmware/hw_layer/g0_extension/README.md
@@ -0,0 +1,14 @@
+G0 uses protocol 9: 36-byte SPI frames with CRC16/CCITT-FALSE in bytes 34..35.
+A reply belongs to the previous exchange. The link checks CRC, command, status,
+payload size, channel and protocol version, then dispatches it to its module.
+Modules rotate fairly; reconnect discards the old pipeline.
+
+Run standalone tests with sanitizers:
+
+```sh
+cmake -S firmware/hw_layer/g0_extension/tests -B /tmp/g0-tests -DG0_SANITIZE=ON
+cmake --build /tmp/g0-tests -j12
+ASAN_OPTIONS=detect_leaks=0 ctest --test-dir /tmp/g0-tests --output-on-failure
+```
+
+Physical SPI and I/O timing still require bench verification.
diff --git a/firmware/hw_layer/g0_extension/g0_spi_protocol.h b/firmware/hw_layer/g0_extension/g0_spi_protocol.h
new file mode 100644
index 0000000000..d611b1aa89
--- /dev/null
+++ b/firmware/hw_layer/g0_extension/g0_spi_protocol.h
@@ -0,0 +1,185 @@
+#pragma once
+
+#include <stdint.h>
+
+namespace g0_spi_protocol {
+
+static constexpr uint8_t analogChannelCount = 12U;
+static constexpr uint8_t digitalInputCount = 4U;
+static constexpr uint8_t outputCount = 4U;
+static constexpr uint16_t outputDutyMax = 10000U;
+
+static constexpr uint8_t appFrameSize = 36U;
+static constexpr uint8_t appHeaderSize = 4U;
+static constexpr uint32_t protocolVersion = 9U;
+
+static constexpr uint8_t versionPayloadLength = 8U;
+static constexpr uint8_t analogPayloadLength = 26U;
+static constexpr uint8_t digitalPayloadLength = 17U;
+static constexpr uint8_t digitalAllPayloadLength = 25U;
+static constexpr uint8_t sentPayloadLength = 9U;
+static constexpr uint8_t outputPayloadLength = 7U;
+
+static constexpr uint8_t cmdNop = 0x00U;
+static constexpr uint8_t cmdReadVersion = 0x01U;
+static constexpr uint8_t cmdReadAnalog = 0x10U;
+static constexpr uint8_t cmdReadDigital = 0x11U;
+static constexpr uint8_t cmdReadDigitalAll = 0x12U;
+static constexpr uint8_t cmdReadSent = 0x13U;
+static constexpr uint8_t cmdSetOutput = 0x20U;
+static constexpr uint8_t cmdDisableOutput = 0x21U;
+static constexpr uint8_t cmdReadOutput = 0x22U;
+static constexpr uint8_t cmdSetInputMode = 0x30U;
+static constexpr uint8_t cmdEnterUpdate = 0xA5U;
+
+static constexpr uint8_t statusReady = 0x00U;
+static constexpr uint8_t statusUpdateMode = 0x01U;
+
+static constexpr uint8_t resultOk = 0x00U;
+static constexpr uint8_t resultInvalid = 0x01U;
+static constexpr uint8_t resultRange = 0x02U;
+static constexpr uint8_t resultBusy = 0x03U;
+
+static constexpr uint8_t digitalMode = 0x00U;
+
+#if defined(__GNUC__)
+#define G0_SPI_PROTOCOL_PACKED __attribute__((packed))
+#else
+#define G0_SPI_PROTOCOL_PACKED
+#endif
+
+struct G0_SPI_PROTOCOL_PACKED ResponseHeader {
+	uint8_t status;
+	uint8_t result;
+	uint8_t command;
+	uint8_t payloadLength;
+};
+
+struct G0_SPI_PROTOCOL_PACKED CommandRequest {
+	uint8_t command;
+};
+
+struct G0_SPI_PROTOCOL_PACKED IndexedRequest {
+	uint8_t command;
+	uint8_t index;
+};
+
+struct G0_SPI_PROTOCOL_PACKED SetInputModeRequest {
+	uint8_t command;
+	uint8_t input;
+	uint8_t mode;
+};
+
+struct G0_SPI_PROTOCOL_PACKED SetOutputRequest {
+	uint8_t command;
+	uint8_t output;
+	uint32_t frequencyHz;
+	uint16_t duty;
+};
+
+struct G0_SPI_PROTOCOL_PACKED VersionResponse {
+	ResponseHeader header;
+	uint32_t version;
+	uint32_t protocolVersion;
+};
+
+struct G0_SPI_PROTOCOL_PACKED AnalogResponse {
+	ResponseHeader header;
+	uint8_t ready;
+	uint8_t channelCount;
+	uint16_t millivolts[analogChannelCount];
+};
+
+struct G0_SPI_PROTOCOL_PACKED DigitalResponse {
+	ResponseHeader header;
+	uint8_t input;
+	uint8_t mode;
+	uint8_t flags;
+	uint32_t frequencyHz;
+	uint16_t dutyPermille;
+	uint16_t periodUs;
+	uint16_t highTimeUs;
+	uint32_t captureCount;
+};
+
+struct G0_SPI_PROTOCOL_PACKED DigitalAllState {
+	uint8_t mode;
+	uint8_t flags;
+	uint16_t frequencyHz;
+	uint16_t dutyPermille;
+};
+
+struct G0_SPI_PROTOCOL_PACKED DigitalAllResponse {
+	ResponseHeader header;
+	uint8_t inputCount;
+	DigitalAllState inputs[digitalInputCount];
+};
+
+struct G0_SPI_PROTOCOL_PACKED SentResponse {
+	ResponseHeader header;
+	uint8_t input;
+	uint32_t data;
+	uint8_t status;
+	uint8_t crc;
+	uint8_t nibbleCount;
+	uint8_t flags;
+};
+
+struct G0_SPI_PROTOCOL_PACKED OutputResponse {
+	ResponseHeader header;
+	uint8_t output;
+	uint32_t frequencyHz;
+	uint16_t duty;
+};
+
+union AppFrame {
+	uint8_t bytes[appFrameSize];
+	CommandRequest commandRequest;
+	IndexedRequest indexedRequest;
+	SetInputModeRequest setInputModeRequest;
+	SetOutputRequest setOutputRequest;
+	ResponseHeader responseHeader;
+	VersionResponse versionResponse;
+	AnalogResponse analogResponse;
+	DigitalResponse digitalResponse;
+	DigitalAllResponse digitalAllResponse;
+	SentResponse sentResponse;
+	OutputResponse outputResponse;
+};
+
+inline uint16_t crc16(const uint8_t* bytes, uint8_t size) {
+	uint16_t crc = 0xFFFFU;
+	for (uint8_t i = 0; i < size; i++) {
+		crc ^= static_cast<uint16_t>(bytes[i]) << 8U;
+		for (uint8_t bit = 0; bit < 8U; bit++) {
+			crc = (crc & 0x8000U) ? (crc << 1U) ^ 0x1021U : crc << 1U;
+		}
+	}
+	return crc;
+}
+
+inline void seal(AppFrame& frame) {
+	const uint16_t crc = crc16(frame.bytes, appFrameSize - 2U);
+	frame.bytes[appFrameSize - 2U] = crc & 0xFFU;
+	frame.bytes[appFrameSize - 1U] = crc >> 8U;
+}
+
+inline bool validFrame(const AppFrame& frame) {
+	return crc16(frame.bytes, appFrameSize - 2U) ==
+		   (frame.bytes[appFrameSize - 2U] | (frame.bytes[appFrameSize - 1U] << 8U));
+}
+
+static_assert(sizeof(ResponseHeader) == appHeaderSize, "Unexpected G0 SPI response header size");
+static_assert(sizeof(VersionResponse) - appHeaderSize == versionPayloadLength, "Unexpected G0 version payload size");
+static_assert(sizeof(AnalogResponse) - appHeaderSize == analogPayloadLength, "Unexpected G0 analog payload size");
+static_assert(sizeof(DigitalResponse) - appHeaderSize == digitalPayloadLength, "Unexpected G0 digital payload size");
+static_assert(
+		sizeof(DigitalAllResponse) - appHeaderSize == digitalAllPayloadLength,
+		"Unexpected G0 digital-all payload size");
+static_assert(sizeof(SentResponse) - appHeaderSize == sentPayloadLength, "Unexpected G0 SENT payload size");
+static_assert(sizeof(OutputResponse) - appHeaderSize == outputPayloadLength, "Unexpected G0 output payload size");
+static_assert(sizeof(AppFrame) == appFrameSize, "Unexpected G0 SPI app frame size");
+
+#undef G0_SPI_PROTOCOL_PACKED
+
+} // namespace g0_spi_protocol
diff --git a/firmware/hw_layer/g0_extension/link.cpp b/firmware/hw_layer/g0_extension/link.cpp
new file mode 100644
index 0000000000..6c0aec7b33
--- /dev/null
+++ b/firmware/hw_layer/g0_extension/link.cpp
@@ -0,0 +1,105 @@
+#include "link.h"
+
+namespace g0 {
+bool validResponse(const wire::AppFrame& tx, const wire::AppFrame& rx) {
+	const auto& h = rx.responseHeader;
+	if (!wire::validFrame(rx) || h.status != wire::statusReady || h.result != wire::resultOk ||
+		h.command != tx.bytes[0]) {
+		return false;
+	}
+	uint8_t size;
+	switch (tx.bytes[0]) {
+		case wire::cmdReadVersion:
+			if (rx.versionResponse.protocolVersion != wire::protocolVersion || rx.versionResponse.version == 0) {
+				return false;
+			}
+			size = wire::versionPayloadLength;
+			break;
+		case wire::cmdReadAnalog:
+			size = wire::analogPayloadLength;
+			break;
+		case wire::cmdReadDigitalAll:
+			size = wire::digitalAllPayloadLength;
+			break;
+		case wire::cmdSetInputMode:
+			if (rx.digitalResponse.input != tx.bytes[1]) {
+				return false;
+			}
+			size = wire::digitalPayloadLength;
+			break;
+		case wire::cmdSetOutput:
+			if (rx.outputResponse.output != tx.bytes[1]) {
+				return false;
+			}
+			size = wire::outputPayloadLength;
+			break;
+		default:
+			return false;
+	}
+	return h.payloadLength == size;
+}
+
+bool Link::attach(Module& module) {
+	for (size_t i = 0; i < m_count; i++) {
+		if (m_modules[i] == &module) {
+			return true;
+		}
+	}
+	if (m_count == MaxModules) {
+		return false;
+	}
+	m_modules[m_count++] = &module;
+	return true;
+}
+
+void Link::prepare(wire::AppFrame& tx, uint32_t nowMs) {
+	m_sendingModule = nullptr;
+	// Rotate even when a module has nothing to send, so outputs cannot starve sensors.
+	for (size_t i = 0; m_online && i < m_count; i++) {
+		auto* module = m_modules[m_next];
+		m_next = (m_next + 1) % m_count;
+		tx = {};
+		if (module->request(tx, nowMs)) {
+			m_sendingModule = module;
+			break;
+		}
+	}
+	if (!m_sendingModule) {
+		tx = {};
+		tx.bytes[0] = wire::cmdReadVersion;
+	}
+	wire::seal(tx);
+}
+
+void Link::disconnect() {
+	m_online = false;
+	m_hasPending = false;
+	m_pendingModule = nullptr;
+	for (size_t i = 0; i < m_count; i++) {
+		m_modules[i]->disconnected();
+	}
+}
+
+void Link::complete(const wire::AppFrame& tx, const wire::AppFrame& rx, bool transferred, uint32_t nowMs) {
+	if (!transferred) {
+		disconnect();
+		return;
+	}
+	if (m_hasPending) {
+		if (uint32_t(nowMs - m_pendingTime) >= SampleTimeoutMs || !validResponse(m_pending, rx)) {
+			disconnect();
+			// The request just sent may execute: discard its reply before checking the version again.
+			return;
+		}
+		if (m_pending.bytes[0] == wire::cmdReadVersion) {
+			m_online = true;
+		} else if (m_pendingModule) {
+			m_pendingModule->response(m_pending, rx, nowMs);
+		}
+	}
+	m_pending = tx;
+	m_pendingModule = m_sendingModule;
+	m_hasPending = true;
+	m_pendingTime = nowMs;
+}
+} // namespace g0
diff --git a/firmware/hw_layer/g0_extension/link.h b/firmware/hw_layer/g0_extension/link.h
new file mode 100644
index 0000000000..22c6cca0ae
--- /dev/null
+++ b/firmware/hw_layer/g0_extension/link.h
@@ -0,0 +1,45 @@
+#pragma once
+
+#include "g0_spi_protocol.h"
+#include <stddef.h>
+#include <stdint.h>
+
+namespace g0 {
+namespace wire = g0_spi_protocol;
+
+constexpr uint32_t SampleTimeoutMs = 250;
+
+// All module callbacks run on the SPI worker. Adapters must lock shared state
+// in these callbacks and in readers/writers, never across an SPI transfer.
+struct Module {
+	virtual bool request(wire::AppFrame& tx, uint32_t nowMs) = 0;
+	virtual void response(const wire::AppFrame& tx, const wire::AppFrame& rx, uint32_t nowMs) = 0;
+	virtual void disconnected() = 0;
+};
+
+class Link {
+public:
+	bool attach(Module& module);
+	// prepare, exchange, then complete with the same TX buffer. RX belongs to the previous request.
+	void prepare(wire::AppFrame& tx, uint32_t nowMs);
+	void complete(const wire::AppFrame& tx, const wire::AppFrame& rx, bool transferred, uint32_t nowMs);
+	bool online() const {
+		return m_online;
+	}
+
+private:
+	void disconnect();
+	static constexpr size_t MaxModules = 4;
+	Module* m_modules[MaxModules] = {};
+	size_t m_count = 0;
+	size_t m_next = 0;
+	Module* m_pendingModule = nullptr;
+	Module* m_sendingModule = nullptr;
+	wire::AppFrame m_pending = {};
+	bool m_hasPending = false;
+	bool m_online = false;
+	uint32_t m_pendingTime = 0;
+};
+
+bool validResponse(const wire::AppFrame& tx, const wire::AppFrame& rx);
+} // namespace g0
