index 382f7ca585..5f962d66d1 100644
--- a/firmware/config/boards/atlas/board.mk
+++ b/firmware/config/boards/atlas/board.mk
@@ -28,3 +28,6 @@ USE_WIFI = yes
 SD_BOOTLOADER = yes
 
 SHORT_BOARD_NAME = atlas
+
+# Build only when the expansion board is fitted.
+G0_EXTENSION ?= no
diff --git a/firmware/config/boards/atlas/board_configuration.cpp b/firmware/config/boards/atlas/board_configuration.cpp
index bfe0719666..60e6983c08 100644
--- a/firmware/config/boards/atlas/board_configuration.cpp
+++ b/firmware/config/boards/atlas/board_configuration.cpp
@@ -2,6 +2,30 @@
 
 #include "adc_subscription.h"
 
+#if EFI_G0_EXTENSION && !EFI_BOOTLOADER
+#include "g0_extension/service.h"
+#include "mpu_util.h"
+
+void initG0Extension() {
+	static bool initialized = false;
+	if (initialized) {
+		return;
+	}
+	initialized = true;
+	turnOnSpi(SPI_DEVICE_5);
+	static SPIConfig g0SpiConfig = {
+			.circular = false,
+			.end_cb = nullptr,
+			.ssport = nullptr,
+			.sspad = 0,
+			.cfg1 = 7 | SPI_CFG1_MBR_2 | SPI_CFG1_MBR_1 | SPI_CFG1_MBR_0,
+			.cfg2 = 0};
+	initSpiCs(&g0SpiConfig, Gpio::F6);
+	palSetPad(g0SpiConfig.ssport, g0SpiConfig.sspad);
+	g0::start(*getSpiDevice(SPI_DEVICE_5), g0SpiConfig);
+}
+#endif
+
 #ifndef EFI_BOOTLOADER
 #include "functional_sensor.h"
 #include "linear_func.h"
@@ -137,6 +161,13 @@ void setBoardConfigOverrides() {
 	engineConfiguration->spi4misoPin = Gpio::E5;
 	engineConfiguration->spi4mosiPin = Gpio::E6;
 
+#if EFI_G0_EXTENSION
+	engineConfiguration->is_enabled_spi_5 = true;
+	engineConfiguration->spi5sckPin = Gpio::F7;
+	engineConfiguration->spi5misoPin = Gpio::F8;
+	engineConfiguration->spi5mosiPin = Gpio::F9;
+#endif
+
 	// Clear SPI SD card pins in case it's enabled from porting a Proteus tune
 	if (engineConfiguration->sdCardSpiDevice || isBrainPinValid(engineConfiguration->sdCardCsPin)) {
 		engineConfiguration->is_enabled_spi_3 = false;
diff --git a/firmware/hw_layer/g0_extension/g0.mk b/firmware/hw_layer/g0_extension/g0.mk
