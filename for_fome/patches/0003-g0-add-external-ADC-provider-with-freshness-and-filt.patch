diff --git a/firmware/hw_layer/g0_extension/analog.h b/firmware/hw_layer/g0_extension/analog.h
new file mode 100644
index 0000000000..e9463fcc29
--- /dev/null
+++ b/firmware/hw_layer/g0_extension/analog.h
@@ -0,0 +1,45 @@
+#pragma once
+#include "link.h"
+#include <cmath>
+
+namespace g0 {
+class Analog : public Module {
+public:
+	bool request(wire::AppFrame& tx, uint32_t) override {
+		tx.bytes[0] = wire::cmdReadAnalog;
+		return true;
+	}
+	void response(const wire::AppFrame&, const wire::AppFrame& rx, uint32_t nowMs) override {
+		const auto& value = rx.analogResponse;
+		m_ready = false;
+		if (value.ready != 1 || value.channelCount != wire::analogChannelCount) {
+			return;
+		}
+		for (size_t i = 0; i < wire::analogChannelCount; i++) {
+			if (value.millivolts[i] > 3300) {
+				return;
+			}
+		}
+		for (size_t i = 0; i < wire::analogChannelCount; i++) {
+			m_millivolts[i] = value.millivolts[i];
+		}
+		m_updated = nowMs;
+		m_ready = true;
+	}
+	void disconnected() override {
+		m_ready = false;
+	}
+	float voltage(size_t index, uint32_t nowMs) const {
+		if (index >= wire::analogChannelCount || !m_ready || uint32_t(nowMs - m_updated) >= SampleTimeoutMs) {
+			return NAN;
+		}
+		return m_millivolts[index] * 0.001f;
+	}
+
+private:
+	bool m_ready = false;
+	uint32_t m_updated = 0;
+	uint16_t m_millivolts[wire::analogChannelCount] = {};
+};
+void registerAnalog(size_t firstChannelIndex);
+} // namespace g0
diff --git a/firmware/hw_layer/g0_extension/analog_provider.cpp b/firmware/hw_layer/g0_extension/analog_provider.cpp
new file mode 100644
index 0000000000..a7d04ae122
--- /dev/null
+++ b/firmware/hw_layer/g0_extension/analog_provider.cpp
@@ -0,0 +1,29 @@
+#include "pch.h"
+#include "analog.h"
+#include "service.h"
+#include "adc_provider.h"
+
+namespace g0 {
+namespace {
+LockedModule<Analog> analog;
+class Provider final : public AdcProvider {
+	const char* name() const override {
+		return "G0";
+	}
+	bool enable(const char*, size_t index) override {
+		return index < wire::analogChannelCount;
+	}
+	void disable(size_t) override {}
+	float get(size_t index) const override {
+		chibios_rt::CriticalSectionLocker lock;
+		return analog.state.voltage(index, nowMs());
+	}
+};
+Provider provider;
+} // namespace
+
+void registerAnalog(size_t firstChannelIndex) {
+	registerAdcProvider(provider, firstChannelIndex, wire::analogChannelCount);
+	link().attach(analog);
+}
+} // namespace g0
