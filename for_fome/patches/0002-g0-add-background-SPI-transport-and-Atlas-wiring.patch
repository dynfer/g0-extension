diff --git a/firmware/config/boards/atlas/board.mk b/firmware/config/boards/atlas/board.mk
index 382f7ca585..6aca6f2a9c 100644
--- a/firmware/config/boards/atlas/board.mk
+++ b/firmware/config/boards/atlas/board.mk
@@ -28,3 +28,6 @@ USE_WIFI = yes
 SD_BOOTLOADER = yes
 
 SHORT_BOARD_NAME = atlas
+
+# Enable when the expansion board is fitted.
+G0_EXTENSION ?= no
diff --git a/firmware/config/boards/atlas/board_configuration.cpp b/firmware/config/boards/atlas/board_configuration.cpp
index bfe0719666..c25f66fc42 100644
--- a/firmware/config/boards/atlas/board_configuration.cpp
+++ b/firmware/config/boards/atlas/board_configuration.cpp
@@ -2,6 +2,21 @@
 
 #include "adc_subscription.h"
 
+#if EFI_G0_EXTENSION && !EFI_BOOTLOADER
+#include "g0_extension/service.h"
+#include "mpu_util.h"
+
+void initG0Extension() {
+	turnOnSpi(SPI_DEVICE_5);
+	SPIConfig g0SpiConfig = {};
+	g0SpiConfig.cfg1 = 7 | SPI_CFG1_MBR_2 | SPI_CFG1_MBR_1 | SPI_CFG1_MBR_0;
+	auto& spi = *getSpiDevice(SPI_DEVICE_5);
+	initSpiCs(&g0SpiConfig, Gpio::F6);
+	palSetPad(g0SpiConfig.ssport, g0SpiConfig.sspad);
+	efiAssertVoid(ObdCode::CUSTOM_ERR_ASSERT, g0::start(spi, g0SpiConfig), "G0 SPI worker full");
+}
+#endif
+
 #ifndef EFI_BOOTLOADER
 #include "functional_sensor.h"
 #include "linear_func.h"
@@ -137,6 +152,13 @@ void setBoardConfigOverrides() {
 	engineConfiguration->spi4misoPin = Gpio::E5;
 	engineConfiguration->spi4mosiPin = Gpio::E6;
 
+#if EFI_G0_EXTENSION
+	engineConfiguration->is_enabled_spi_5 = true;
+	engineConfiguration->spi5sckPin = Gpio::F7;
+	engineConfiguration->spi5misoPin = Gpio::F8;
+	engineConfiguration->spi5mosiPin = Gpio::F9;
+#endif
+
 	// Clear SPI SD card pins in case it's enabled from porting a Proteus tune
 	if (engineConfiguration->sdCardSpiDevice || isBrainPinValid(engineConfiguration->sdCardCsPin)) {
 		engineConfiguration->is_enabled_spi_3 = false;
diff --git a/firmware/hw_layer/g0_extension/README.md b/firmware/hw_layer/g0_extension/README.md
index 13458c55bf..593a1279f7 100644
--- a/firmware/hw_layer/g0_extension/README.md
+++ b/firmware/hw_layer/g0_extension/README.md
@@ -3,6 +3,10 @@ A reply belongs to the previous exchange. The link checks CRC, command, status,
 payload size, channel and protocol version, then dispatches it to its module.
 Modules rotate fairly; reconnect discards the old pipeline.
 
+Enable Atlas with `G0_EXTENSION=yes`. SPI5 uses PF7/PF8/PF9 and PF6 for CS.
+Only the 10 ms background worker transfers data. DMA buffers are noncached on H7.
+State locks cover module callbacks and readers/writers, never SPI transfers.
+
 Run standalone tests with sanitizers:
 
 ```sh
diff --git a/firmware/hw_layer/g0_extension/g0.mk b/firmware/hw_layer/g0_extension/g0.mk
new file mode 100644
index 0000000000..55370e75e5
--- /dev/null
+++ b/firmware/hw_layer/g0_extension/g0.mk
@@ -0,0 +1,6 @@
+ifeq ($(G0_EXTENSION),yes)
+DDEFS += -DEFI_G0_EXTENSION=TRUE
+HW_LAYER_EMS_CPP += \
+	$(PROJECT_DIR)/hw_layer/g0_extension/link.cpp \
+	$(PROJECT_DIR)/hw_layer/g0_extension/service.cpp
+endif
diff --git a/firmware/hw_layer/g0_extension/service.cpp b/firmware/hw_layer/g0_extension/service.cpp
new file mode 100644
index 0000000000..c301357833
--- /dev/null
+++ b/firmware/hw_layer/g0_extension/service.cpp
@@ -0,0 +1,51 @@
+#include "pch.h"
+#include "service.h"
+#include "spi_thread.h"
+#include "mpu_util.h"
+
+namespace g0 {
+namespace {
+// SPI DMA must not access stack or cached SRAM on H7.
+NO_CACHE wire::AppFrame txBuffer;
+NO_CACHE wire::AppFrame rxBuffer;
+Link instance;
+
+class Device final : public BackgroundSpiDevice {
+public:
+	SPIDriver* driver = nullptr;
+	SPIConfig spiConfig = {};
+	SPIDriver* spiDriver() const override {
+		return driver;
+	}
+	const SPIConfig& config() override {
+		return spiConfig;
+	}
+	int getSpiThreadPeriodMs() const override {
+		return 10;
+	}
+	void performTransfer(SPIDriver& spi) override {
+		instance.prepare(txBuffer, nowMs());
+		rxBuffer = {};
+		spiSelect(&spi);
+		// This fome-fw ChibiOS HAL has a void synchronous spiExchange API.
+		spiExchange(&spi, wire::appFrameSize, txBuffer.bytes, rxBuffer.bytes);
+		spiUnselect(&spi);
+		instance.complete(txBuffer, rxBuffer, true, nowMs());
+	}
+};
+Device device;
+} // namespace
+
+uint32_t nowMs() {
+	return static_cast<uint32_t>(NT2US(getTimeNowNt()) / 1000);
+}
+Link& link() {
+	return instance;
+}
+
+bool start(SPIDriver& driver, const SPIConfig& spiSettings) {
+	device.driver = &driver;
+	device.spiConfig = spiSettings;
+	return registerBackgroundSpiDevice(device);
+}
+} // namespace g0
diff --git a/firmware/hw_layer/g0_extension/service.h b/firmware/hw_layer/g0_extension/service.h
new file mode 100644
index 0000000000..6cef5fc959
--- /dev/null
+++ b/firmware/hw_layer/g0_extension/service.h
@@ -0,0 +1,30 @@
+#pragma once
+
+#include "link.h"
+
+namespace g0 {
+// Attach modules during board initialization, before start().
+Link& link();
+bool start(SPIDriver& driver, const SPIConfig& spiSettings);
+uint32_t nowMs();
+
+template <class T>
+struct LockedModule final : Module {
+	T state;
+	bool request(wire::AppFrame& tx, uint32_t now) override {
+		chibios_rt::CriticalSectionLocker lock;
+		return state.request(tx, now);
+	}
+	void response(const wire::AppFrame& tx, const wire::AppFrame& rx, uint32_t now) override {
+		chibios_rt::CriticalSectionLocker lock;
+		state.response(tx, rx, now);
+	}
+	void disconnected() override {
+		chibios_rt::CriticalSectionLocker lock;
+		state.disconnected();
+	}
+};
+} // namespace g0
+
+// Implemented by the board, called after initSpiModules and before GPIO/sensors.
+void initG0Extension();
