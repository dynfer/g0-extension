From 020223048face4e653269fff4a709c161257d4c1 Mon Sep 17 00:00:00 2001
From: dynfer <denesius20@gmail.com>
Date: Wed, 18 Nov 2026 17:15:46 +0100
Subject: [PATCH] g0: release BOOT0 after initialization for SWD access

G071 BOOT0 shares PA14 with SWCLK. Keep driving boot selection during reset and ROM programming, then switch the host control pin to input with pull-down after SPI cleanup on success or failure. Retain pin ownership and leave NRST behavior unchanged.

Assert that boot remains driven throughout reset/transfers and is released on every tested updater exit path.
---
 firmware/CHANGELOG.md                                    | 1 +
 firmware/hw_layer/g0_extension/README.md                 | 5 ++++-
 firmware/hw_layer/g0_extension/tests/test_updater.cpp    | 3 +++
 firmware/hw_layer/g0_extension/tests/updater_mocks/pch.h | 7 +++++++
 firmware/hw_layer/g0_extension/updater.cpp               | 3 ++-
 5 files changed, 17 insertions(+), 2 deletions(-)

diff --git a/firmware/CHANGELOG.md b/firmware/CHANGELOG.md
index 80573a035c..14f98eb050 100644
--- a/firmware/CHANGELOG.md
+++ b/firmware/CHANGELOG.md
@@ -70,6 +70,7 @@ or
  - Instant RPM is now used automatically on triggers with 24 or more teeth per engine cycle (a 12 tooth crank wheel or better), instead of only when "Always use instant RPM" was enabled. RPM, and everything derived from it, now responds within a fraction of an engine cycle instead of once per cycle. The setting remains, and now forces instant RPM on triggers with fewer teeth than that.
 
 ### Fixed
+ - Release G0 BOOT0 after initialization so its shared SWCLK pin remains available to a debugger while the ECU runs.
  - G0 PWM accepts paused frequency values used by tachometer/speedometer outputs and follows the global PWM enable setting.
  - Keep configured SPI5 thermocouples deselected during G0 initialization and firmware upload on Atlas.
  - Reset G0 after firmware upload, avoid scheduler-tick delays per SPI byte, and show upload activity while yielding to other threads.
diff --git a/firmware/hw_layer/g0_extension/README.md b/firmware/hw_layer/g0_extension/README.md
index f3bbbc8da6..5a179b4fea 100644
--- a/firmware/hw_layer/g0_extension/README.md
+++ b/firmware/hw_layer/g0_extension/README.md
@@ -57,7 +57,10 @@ No prepared binary/header is needed. Update the submodule pin for a new release.
 Before registering remote I/O, the updater first probes an existing G071 ROM
 session without pulsing NRST. This preserves factory-blank entry on ROM versions
 that clear the EMPTY flag during startup. RESET and BOOT output latches are
-preloaded high before enabling their GPIO drivers. Atlas also keeps PB14/NRST
+preloaded high before enabling their GPIO drivers. At updater completion, BOOT
+is released to input mode with a weak pull-down on both success and failure:
+G071 BOOT0 shares PA14/SWCLK and must not be driven during normal debugging.
+Atlas also keeps PB14/NRST
 pulled up during both ECU bootloader and main-firmware GPIO initialization. A running application follows
 the normal reset/version-check path; a matching image skips programming.
 
diff --git a/firmware/hw_layer/g0_extension/tests/test_updater.cpp b/firmware/hw_layer/g0_extension/tests/test_updater.cpp
index 9b066155e3..880564fc84 100644
--- a/firmware/hw_layer/g0_extension/tests/test_updater.cpp
+++ b/firmware/hw_layer/g0_extension/tests/test_updater.cpp
@@ -14,6 +14,7 @@ unsigned romBytes;
 
 void palWritePad(unsigned, unsigned pin, bool high) {
 	if (pin == Gpio::B14 && testPinOutputs[pin] && !high) {
+		assert(testPinOutputs[Gpio::B15]); // Drive BOOT0 throughout reset selection.
 		testResetPulses.push_back(Gpio::B14);
 		if (romBytes && !missingDevice && !appRunning) {
 			assert(rom->offset == rom->bytes.size()); // Never reset a factory ROM before Go.
@@ -27,6 +28,7 @@ void palWritePad(unsigned, unsigned pin, bool high) {
 
 void spiExchange(SPIDriver*, size_t size, const void* tx, void* rx) {
 	assert(testSelected && testStarted && testBusLocked);
+	assert(testPinOutputs[Gpio::B15]); // Release SWCLK only after initialization finishes.
 	if (size == g0::wire::appFrameSize) {
 		appExchanges++;
 		auto& reply = *static_cast<g0::wire::AppFrame*>(rx);
@@ -75,6 +77,7 @@ static void init(boot_test::Script& script, bool running) {
 static void finished() {
 	assert(!testSelected && !testStarted && !testBusLocked);
 	assert(!testPins[Gpio::B15] && testPins[Gpio::B14]);
+	assert(!testPinOutputs[Gpio::B15] && testPinOutputs[Gpio::B14]);
 }
 
 int main() {
diff --git a/firmware/hw_layer/g0_extension/tests/updater_mocks/pch.h b/firmware/hw_layer/g0_extension/tests/updater_mocks/pch.h
index ae619564ee..e22f6b697c 100644
--- a/firmware/hw_layer/g0_extension/tests/updater_mocks/pch.h
+++ b/firmware/hw_layer/g0_extension/tests/updater_mocks/pch.h
@@ -12,6 +12,7 @@ using brain_pin_e = Gpio;
 struct SPIDriver {};
 struct SPIConfig {};
 constexpr unsigned PAL_MODE_OUTPUT_PUSHPULL = 1;
+constexpr unsigned PAL_MODE_INPUT_PULLDOWN = 2;
 inline bool testPins[] = {true, false};
 inline bool testPinOutputs[2] = {};
 inline std::vector<Gpio> testResetPulses;
@@ -57,6 +58,12 @@ inline void efiSetPadMode(const char*, Gpio pin, unsigned) {
 						   // output driver.
 	testPinOutputs[pin] = true;
 }
+inline void efiSetPadModeWithoutOwnershipAcquisition(const char*, Gpio pin, unsigned mode) {
+	assert(pin == Gpio::B15 && mode == PAL_MODE_INPUT_PULLDOWN);
+	assert(!testPins[pin] && testPinOutputs[pin]);
+	assert(!testSelected && !testStarted && !testBusLocked);
+	testPinOutputs[pin] = false;
+}
 inline void spiAcquireBus(SPIDriver*) {
 	assert(!testBusLocked);
 	testBusLocked = true;
diff --git a/firmware/hw_layer/g0_extension/updater.cpp b/firmware/hw_layer/g0_extension/updater.cpp
index 19ea897865..c883d338a2 100644
--- a/firmware/hw_layer/g0_extension/updater.cpp
+++ b/firmware/hw_layer/g0_extension/updater.cpp
@@ -130,8 +130,9 @@ bool updateFirmware(SPIDriver& spi, const SPIConfig& spiSettings, brain_pin_e re
 	spiUnselect(&spi);
 	spiStop(&spi);
 	spiReleaseBus(&spi);
-	// Retain ownership: these are dedicated expansion control pins.
 	pin(bootPin, false);
+	// G071 BOOT0 shares SWCLK: release the line so an attached debugger can drive it.
+	efiSetPadModeWithoutOwnershipAcquisition("G0 BOOT", bootPin, PAL_MODE_INPUT_PULLDOWN);
 	pin(resetPin, true);
 	enginePins.runningLedPin.setValue(0);
 	efiPrintf("G0 firmware %s", ok ? "ready" : "failed");
-- 
