diff --git a/firmware/hw_layer/g0_extension/README.md b/firmware/hw_layer/g0_extension/README.md
index db413947ba..f3bbbc8da6 100644
--- a/firmware/hw_layer/g0_extension/README.md
+++ b/firmware/hw_layer/g0_extension/README.md
@@ -31,7 +31,12 @@ SENT is unsupported.
 Outputs start off. Callers queue setpoints, and only a matching acknowledgement
 clears them; changes while an ACK is in flight stay pending. Setpoints refresh
 every second and after reconnect. `SimplePwm` supports duty, frequency and
-inversion, including Lua frequency changes. Deinitializing a pin turns it off.
+inversion, including Lua frequency changes. Zero, sub-1 Hz and NaN frequencies
+pause PWM at its logical inactive level, retaining duty for the next valid
+frequency. Negative, infinite and over-500 Hz frequencies remain invalid.
+The worker applies FOME's global PWM enable state on every poll, including when
+no controller update occurs; re-enabling restores the latest active PWM setpoints.
+Static GPIO outputs are independent of that flag. Deinitializing a pin turns it off.
 The companion preserves PWM cycles during duty updates and disables outputs after
 500 ms without a checksum-valid frame. These outputs are for asynchronous
 auxiliary loads: they cannot follow crank/cam timing through SPI.
diff --git a/firmware/hw_layer/g0_extension/output_gpio.cpp b/firmware/hw_layer/g0_extension/output_gpio.cpp
index 8f7978a1e5..3990c74abb 100644
--- a/firmware/hw_layer/g0_extension/output_gpio.cpp
+++ b/firmware/hw_layer/g0_extension/output_gpio.cpp
@@ -9,6 +9,10 @@
 namespace g0 {
 namespace {
 LockedModule<Outputs> outputs;
+
+bool validFrequency(float value) {
+	return std::isnan(value) || (std::isfinite(value) && value >= 0 && value <= 500);
+}
 class Pwm final : public hardware_pwm {
 public:
 	size_t index = 0;
@@ -22,19 +26,25 @@ public:
 			return;
 		}
 		duty = value;
-		outputs.state.set(index, frequency, uint16_t((inverted ? 1 - duty : duty) * wire::outputDutyMax + 0.5f));
+		apply();
 	}
 	void setFrequency(float value) override {
 		chibios_rt::CriticalSectionLocker lock;
 		if (!active) {
 			return;
 		}
-		if (!std::isfinite(value) || value < 1 || value > 500) {
+		if (!validFrequency(value)) {
 			warning(ObdCode::CUSTOM_ERR_PWM_STATE_ASSERT, "G0 PWM range (1..500 Hz)");
 			return;
 		}
-		frequency = uint32_t(value + 0.5f);
-		setDuty(duty);
+		frequency = std::isnan(value) || value < 1 ? 0 : uint32_t(value + 0.5f);
+		apply();
+	}
+	void apply() {
+		const bool running = engine->isPwmEnabled && frequency != 0;
+		const float value = running ? duty : 0;
+		outputs.state.set(
+				index, running ? frequency : 0, uint16_t((inverted ? 1 - value : value) * wire::outputDutyMax + 0.5f));
 	}
 };
 Pwm pwms[wire::outputCount];
@@ -70,20 +80,28 @@ bool isOutput(brain_pin_e pin) {
 }
 
 hardware_pwm* startPwm(brain_pin_e pin, float frequency, float duty, bool inverted) {
-	if (!isOutput(pin) || !std::isfinite(frequency) || frequency < 1 || frequency > 500 || !std::isfinite(duty) ||
-		duty < 0 || duty > 1) {
+	if (!isOutput(pin) || !validFrequency(frequency) || !std::isfinite(duty) || duty < 0 || duty > 1) {
 		return nullptr;
 	}
 	chibios_rt::CriticalSectionLocker lock;
 	auto& pwm = pwms[pin - Gpio::G0_OUT_1];
 	pwm.index = pin - Gpio::G0_OUT_1;
-	pwm.frequency = uint32_t(frequency + 0.5f);
 	pwm.active = true;
 	pwm.inverted = inverted;
-	pwm.setDuty(duty);
+	pwm.duty = duty;
+	pwm.setFrequency(frequency);
 	return &pwm;
 }
 
+void updatePwmOutputs() {
+	chibios_rt::CriticalSectionLocker lock;
+	for (auto& pwm : pwms) {
+		if (pwm.active) {
+			pwm.apply();
+		}
+	}
+}
+
 void registerOutputs() {
 	efiAssertVoid(
 			ObdCode::CUSTOM_ERR_ASSERT,
