diff --git a/firmware/hw_layer/g0_extension/digital.h b/firmware/hw_layer/g0_extension/digital.h
new file mode 100644
index 0000000000..2193ffda61
--- /dev/null
+++ b/firmware/hw_layer/g0_extension/digital.h
@@ -0,0 +1,80 @@
+#pragma once
+#include "link.h"
+
+namespace g0 {
+// SENT is intentionally excluded: the current G0 decoder does not check CRCs.
+enum class InputMode : uint8_t {
+	Digital = 0,
+	Frequency = 1
+};
+
+class Digital : public Module {
+public:
+	bool setMode(size_t index, InputMode mode) {
+		if (index >= wire::digitalInputCount || uint8_t(mode) > uint8_t(InputMode::Frequency)) {
+			return false;
+		}
+		m_modes[index] = mode;
+		m_ready = false;
+		return true;
+	}
+	bool request(wire::AppFrame& tx, uint32_t) override {
+		for (size_t i = 0; i < wire::digitalInputCount; i++) {
+			if (m_configured[i] && m_applied[i] == m_modes[i]) {
+				continue;
+			}
+			tx.setInputModeRequest = {wire::cmdSetInputMode, uint8_t(i + 1), uint8_t(m_modes[i])};
+			return true;
+		}
+		tx.bytes[0] = wire::cmdReadDigitalAll;
+		return true;
+	}
+	void response(const wire::AppFrame& tx, const wire::AppFrame& rx, uint32_t nowMs) override {
+		if (tx.bytes[0] == wire::cmdSetInputMode) {
+			const size_t index = tx.setInputModeRequest.input - 1;
+			if (index >= wire::digitalInputCount) {
+				return;
+			}
+			m_applied[index] = InputMode(rx.digitalResponse.mode);
+			m_configured[index] = rx.digitalResponse.mode == tx.setInputModeRequest.mode;
+			return;
+		}
+		m_ready = false;
+		if (rx.digitalAllResponse.inputCount != wire::digitalInputCount) {
+			return;
+		}
+		for (size_t i = 0; i < wire::digitalInputCount; i++) {
+			const auto& input = rx.digitalAllResponse.inputs[i];
+			if (input.mode != uint8_t(m_modes[i]) || input.dutyPermille > 1000 || (input.flags & ~3U)) {
+				return;
+			}
+		}
+		for (size_t i = 0; i < wire::digitalInputCount; i++) {
+			m_inputs[i] = rx.digitalAllResponse.inputs[i];
+		}
+		m_updated = nowMs;
+		m_ready = true;
+	}
+	void disconnected() override {
+		m_ready = false;
+		for (auto& configured : m_configured) {
+			configured = false;
+		}
+	}
+	bool sample(size_t index, uint32_t nowMs, wire::DigitalAllState& sample) const {
+		if (index >= wire::digitalInputCount || !m_ready || uint32_t(nowMs - m_updated) >= SampleTimeoutMs) {
+			return false;
+		}
+		sample = m_inputs[index];
+		return true;
+	}
+
+private:
+	InputMode m_modes[wire::digitalInputCount] = {};
+	InputMode m_applied[wire::digitalInputCount] = {};
+	bool m_configured[wire::digitalInputCount] = {};
+	wire::DigitalAllState m_inputs[wire::digitalInputCount] = {};
+	uint32_t m_updated = 0;
+	bool m_ready = false;
+};
+} // namespace g0
diff --git a/firmware/hw_layer/g0_extension/digital_gpio.cpp b/firmware/hw_layer/g0_extension/digital_gpio.cpp
new file mode 100644
index 0000000000..1eb61488c5
--- /dev/null
+++ b/firmware/hw_layer/g0_extension/digital_gpio.cpp
@@ -0,0 +1,36 @@
+#include "pch.h"
+#include "digital.h"
+#include "service.h"
+#include "drivers/gpio/gpio_ext.h"
+
+namespace g0 {
+namespace {
+LockedModule<Digital> digital;
+class Inputs final : public GpioChip {
+	int init() override {
+		return 0;
+	}
+	int setPadMode(size_t pin, iomode_t mode) override {
+		// Pull resistors are determined by the expansion board hardware.
+		return pin < wire::digitalInputCount && mode == PAL_MODE_INPUT ? 0 : -1;
+	}
+	int readPad(size_t pin) override {
+		chibios_rt::CriticalSectionLocker lock;
+		wire::DigitalAllState value;
+		if (!digital.state.sample(pin, nowMs(), value)) {
+			return -1;
+		}
+		return (value.flags & 1) != 0;
+	}
+};
+Inputs inputs;
+} // namespace
+
+void registerDigital() {
+	efiAssertVoid(
+			ObdCode::CUSTOM_ERR_ASSERT,
+			gpiochip_register(Gpio::G0_DIGITAL_1, "G0 inputs", inputs, wire::digitalInputCount) >= 0,
+			"G0 inputs");
+	link().attach(digital);
+}
+} // namespace g0
