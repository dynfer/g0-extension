diff --git a/firmware/hw_layer/g0_extension/tests/mocks/pch.h b/firmware/hw_layer/g0_extension/tests/mocks/pch.h
new file mode 100644
index 0000000000..35d70b590f
--- /dev/null
+++ b/firmware/hw_layer/g0_extension/tests/mocks/pch.h
@@ -0,0 +1,38 @@
+#pragma once
+#include <cassert>
+#include <cstdint>
+#include <cstddef>
+enum Gpio {
+	G0_OUT_1 = 219,
+	G0_OUT_2,
+	G0_OUT_3,
+	G0_OUT_4
+};
+using brain_pin_e = Gpio;
+using iomode_t = unsigned;
+struct SPIDriver {};
+struct SPIConfig {};
+namespace ObdCode {
+enum Code {
+	CUSTOM_ERR_ASSERT,
+	CUSTOM_ERR_PWM_STATE_ASSERT
+};
+} // namespace ObdCode
+inline unsigned testWarnings = 0;
+inline void warning(ObdCode::Code, const char*) {
+	++testWarnings;
+}
+#define efiAssertVoid(code, condition, text) assert(condition)
+constexpr unsigned PAL_STM32_MODE_MASK = 3, PAL_MODE_OUTPUT_PUSHPULL = 1;
+namespace chibios_rt {
+struct CriticalSectionLocker {
+	inline static unsigned depth = 0;
+	CriticalSectionLocker() {
+		++depth;
+	}
+	~CriticalSectionLocker() {
+		assert(depth);
+		--depth;
+	}
+};
+} // namespace chibios_rt
diff --git a/firmware/hw_layer/g0_extension/tests/test.cpp b/firmware/hw_layer/g0_extension/tests/test.cpp
index a31f45d97b..0bda6fa0eb 100644
--- a/firmware/hw_layer/g0_extension/tests/test.cpp
+++ b/firmware/hw_layer/g0_extension/tests/test.cpp
@@ -1,6 +1,7 @@
 #include "../link.h"
 #include "../analog.h"
 #include "../digital.h"
+#include "../outputs.h"
 #include <cassert>
 #include <cstdio>
 
@@ -255,6 +256,39 @@ static void testModeChangeDuringAck() {
 	assert(tx.setInputModeRequest.input == 2);
 }
 
+static void testOutputs() {
+	Outputs outputs;
+	wire::AppFrame tx = {};
+	assert(!outputs.set(4, 0, 0));
+	assert(!outputs.set(0, 501, 0));
+	assert(!outputs.set(0, 1, 10001));
+	// Acknowledge startup off commands.
+	for (unsigned i = 0; i < wire::outputCount; i++) {
+		assert(outputs.request(tx, 0));
+		assert(tx.bytes[0] == wire::cmdSetOutput);
+		assert(tx.setOutputRequest.frequencyHz == 0 && tx.setOutputRequest.duty == 0);
+		outputs.response(tx, {}, 0);
+	}
+	assert(!outputs.request(tx, 10));
+	assert(outputs.set(0, 100, 5000));
+	assert(outputs.request(tx, 20));
+	assert(tx.setOutputRequest.frequencyHz == 100);
+	assert(!outputs.request(tx, 20));  // Same output cannot have two requests in flight.
+	assert(outputs.set(0, 200, 2500)); // Producer changes while ACK is in flight.
+	wire::AppFrame rx = {};
+	rx.outputResponse.frequencyHz = 100;
+	rx.outputResponse.duty = 5000;
+	outputs.response(tx, rx, 30);
+	assert(outputs.request(tx, 40));
+	assert(tx.setOutputRequest.frequencyHz == 200 && tx.setOutputRequest.duty == 2500);
+	rx.outputResponse.frequencyHz = 200;
+	rx.outputResponse.duty = 2500;
+	outputs.response(tx, rx, 50);
