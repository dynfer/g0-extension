diff --git a/firmware/hw_layer/g0_extension/tests/test_bootloader.cpp b/firmware/hw_layer/g0_extension/tests/test_bootloader.cpp
new file mode 100644
index 0000000000..98d012e25c
--- /dev/null
+++ b/firmware/hw_layer/g0_extension/tests/test_bootloader.cpp
@@ -0,0 +1,118 @@
+#include "../bootloader.h"
+#include <cassert>
+#include <utility>
+#include <vector>
+
+using namespace g0;
+
+namespace {
+struct Script : BootTransport {
+	std::vector<std::pair<uint8_t, uint8_t>> bytes;
+	size_t offset = 0;
+	uint32_t waited = 0;
+	uint8_t byte(uint8_t value) override {
+		assert(offset < bytes.size());
+		const auto expected = bytes[offset++];
+		assert(value == expected.first);
+		return expected.second;
+	}
+	void sleepMs(uint32_t delay) override {
+		waited += delay;
+	}
+	void send(std::initializer_list<uint8_t> values) {
+		// Spurious MISO ACKs while sending must not truncate the outgoing packet.
+		for (auto value : values) {
+			bytes.emplace_back(value, 0x79);
+		}
+	}
+	void ack() {
+		bytes.insert(bytes.end(), {{0, 0xa5}, {0, 0x79}, {0x79, 0xa5}});
+	}
+};
+
+std::vector<uint8_t> image() {
+	std::vector<uint8_t> data(258, 0x79);
+	// SP = top of 36 KiB RAM, reset vector = flash + 9 (Thumb).
+	const uint8_t vectors[] = {0, 0x90, 0, 0x20, 9, 0, 0, 8};
+	for (size_t i = 0; i < 8; i++) {
+		data[i] = vectors[i];
+	}
+	return data;
+}
+
+Script flashScript(const std::vector<uint8_t>& data, bool corrupt) {
+	Script io;
+	io.send({0x5a});
+	io.ack();
+	io.send({0x5a, 0x44, 0xbb});
+	io.ack();
+	io.send({255, 255, 0});
+	io.ack();
+	for (unsigned block = 0; block < 2; block++) {
+		const uint8_t a[] = {8, 0, uint8_t(block), 0, uint8_t(8 ^ block)};
+		io.send({0x5a, 0x31, 0xce});
+		io.ack();
+		io.send({a[0], a[1], a[2], a[3], a[4]});
+		io.ack();
+		io.send({255});
+		uint8_t checksum = 255;
+		for (size_t i = 0; i < 256; i++) {
+			const size_t offset = block * 256 + i;
+			const uint8_t value = offset < data.size() ? data[offset] : 255;
+			io.bytes.emplace_back(value, 0x79);
+			checksum ^= value;
+		}
+		io.send({checksum});
+		io.ack();
+		io.send({0x5a, 0x11, 0xee});
+		io.ack();
+		io.send({a[0], a[1], a[2], a[3], a[4]});
+		io.ack();
+		io.send({255, 0});
+		io.ack();
+		io.bytes.emplace_back(0, 0xa5);
+		for (size_t i = 0; i < 256; i++) {
+			const size_t offset = block * 256 + i;
+			uint8_t value = offset < data.size() ? data[offset] : 255;
+			if (corrupt && block == 0 && i == 10) {
+				value ^= 1;
+			}
+			io.bytes.emplace_back(0, value);
+		}
+		if (corrupt) {
+			break;
+		}
+	}
+	return io;
+}
+} // namespace
+
+void testBootloader() {
+	auto data = image();
+	assert(Bootloader::validImage(data.data(), data.size()));
+	assert(!Bootloader::validImage(nullptr, data.size()));
+	assert(!Bootloader::validImage(data.data(), 7));
+	assert(!Bootloader::validImage(data.data(), Bootloader::FlashSize + 1));
+	auto io = flashScript(data, false);
+	Bootloader loader(io);
+	assert(loader.flash(data.data(), data.size()));
+	assert(io.offset == io.bytes.size());
+	auto corrupt = flashScript(data, true);
+	assert(!Bootloader(corrupt).flash(data.data(), data.size()));
+	assert(corrupt.offset == corrupt.bytes.size());
+	Script nack;
+	nack.send({0x5a});
+	nack.bytes.insert(nack.bytes.end(), {{0, 0xa5}, {0, 0x1f}});
+	assert(!Bootloader(nack).flash(data.data(), data.size()));
+	Script timeout;
+	timeout.send({0x5a});
+	for (unsigned i = 0; i < 1001; i++) {
+		timeout.bytes.emplace_back(0, 0);
+	}
+	assert(!Bootloader(timeout).flash(data.data(), data.size()));
+	assert(timeout.waited == 1000);
+	data[4] = 8; // ARM vector instead of Thumb.
+	Script untouched;
+	assert(!Bootloader(untouched).flash(data.data(), data.size()));
+	assert(untouched.offset == 0);
+}
diff --git a/firmware/hw_layer/g0_extension/tests/test_image.py b/firmware/hw_layer/g0_extension/tests/test_image.py
new file mode 100644
index 0000000000..ef1187f4cd
--- /dev/null
+++ b/firmware/hw_layer/g0_extension/tests/test_image.py
@@ -0,0 +1,97 @@
+import importlib.util
+from pathlib import Path
+import struct
+import subprocess
+import sys
+import tempfile
+import unittest
+from unittest.mock import patch
+
+
+GENERATOR = Path(__file__).resolve().parents[1] / "make_image.py"
+spec = importlib.util.spec_from_file_location("make_g0_image", GENERATOR)
+generator = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(generator)
+
+
+class ImageTests(unittest.TestCase):
+    def setUp(self):
+        self.directory = tempfile.TemporaryDirectory()
+        self.addCleanup(self.directory.cleanup)
+        self.root = Path(self.directory.name)
+        self.binary = self.root / "firmware.bin"
+        self.binary.write_bytes(struct.pack("<II", 0x20009000, 0x08000009) + bytes(16))
+        self.source = self.root / "g0_firmware_version.h"
+        self.source.write_text("#define G0_FIRMWARE_VERSION 0x12345678U\n")
+        self.header = self.root / "generated" / "g0_firmware_image.h"
+
+    def generate(self, *options):
+        argv = [str(GENERATOR), "--input", str(self.binary), "--output", str(self.header), *options]
+        with patch.object(sys, "argv", argv):
+            generator.main()
+
+    def test_source_version_and_incremental_header(self):
+        self.generate("--version-header", str(self.source))
+        self.assertIn("version = 305419896;", self.header.read_text())
+        self.assertIn("static const unsigned char data[]", self.header.read_text())
+        before = self.header.stat().st_mtime_ns
+        self.generate("--version-header", str(self.source))
+        self.assertEqual(before, self.header.stat().st_mtime_ns)
+        image = bytearray(self.binary.read_bytes())
+        image[-1] = 1
+        self.binary.write_bytes(image)
+        original = self.header.read_text()
+        self.generate("--version-header", str(self.source))
+        self.assertNotEqual(original, self.header.read_text())
+        self.assertFalse(self.header.with_suffix(".h.tmp").exists())
+
+    def test_identity_is_independent_of_protocol(self):
+        self.source.write_text("#define G0_FIRMWARE_VERSION 9U\n")
+        self.generate("--version-header", str(self.source))
+        self.assertIn("version = 9;", self.header.read_text())
+
+    def test_missing_ambiguous_or_unsupported_source_version(self):
+        for text in ["", "#define G0_FIRMWARE_VERSION 0U", "#define G0_FIRMWARE_VERSION 0x100000000U",
+                     "#define G0_FIRMWARE_VERSION 0x12345678U\n" * 2]:
+            with self.subTest(source=text):
+                self.source.write_text(text)
+                with self.assertRaises(SystemExit):
+                    self.generate("--version-header", str(self.source))
+                self.assertFalse(self.header.exists())
+
+    def test_invalid_binary_does_not_replace_previous_image(self):
+        self.generate("--version-header", str(self.source))
+        original = self.header.read_bytes()
+        for image in [b"short", bytes(128 * 1024 + 1),
+                      struct.pack("<II", 0x20009000, 0x08000008) + bytes(16)]:
+            with self.subTest(size=len(image)):
+                self.binary.write_bytes(image)
+                with self.assertRaises(SystemExit):
+                    self.generate("--version-header", str(self.source))
+                self.assertEqual(original, self.header.read_bytes())
+
+    def test_disabled_build_skips_companion_dependency(self):
+        makefile = self.root / "Makefile"
+        image_rules = GENERATOR.with_name("image.mk")
+        firmware = self.root / "firmware"
+        makefile.write_text(
+            f"PROJECT_DIR := {firmware}\n"
+            f"BUILDDIR := {self.root / 'build'}\n"
+            f"GENERATED_DIR := {self.root / 'generated'}\n"
+            f"OBJS := {self.root / 'done'}\n"
+            "PCHOBJ :=\n"
+            ".PHONY: all\nall: $(OBJS)\n"
+            "$(OBJS):\n\ttouch $@\n"
+            f"include {image_rules}\n"
+        )
+        for options in [["G0_EXTENSION=no", "G0_FIRMWARE_UPDATE=yes"],
+                        ["G0_EXTENSION=yes", "G0_FIRMWARE_UPDATE=no"]]:
+            with self.subTest(options=options):
+                subprocess.run(["make", "-f", str(makefile), "-j12", *options, "all"],
+                               cwd=self.root, check=True, capture_output=True)
+                self.assertFalse(firmware.exists())
+                self.assertFalse(self.header.exists())
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/firmware/hw_layer/g0_extension/updater.cpp b/firmware/hw_layer/g0_extension/updater.cpp
new file mode 100644
index 0000000000..f0113c5e8d
--- /dev/null
+++ b/firmware/hw_layer/g0_extension/updater.cpp
@@ -0,0 +1,94 @@
+#include "pch.h"
+#include "updater.h"
+#include "bootloader.h"
+#include "g0_firmware_image.h"
+#include "link.h"
+#include "mpu_util.h"
+
+namespace g0 {
+namespace {
+NO_CACHE wire::AppFrame tx;
+NO_CACHE wire::AppFrame rx;
+
+void pin(brain_pin_e line, bool high) {
+	palWritePad(getHwPort("G0", line), getHwPin("G0", line), high);
+}
+
+void reset(brain_pin_e resetPin, brain_pin_e bootPin, bool rom) {
+	pin(bootPin, rom);
+	chThdSleepMilliseconds(5);
+	pin(resetPin, false);
+	chThdSleepMilliseconds(20);
+	pin(resetPin, true);
+	chThdSleepMilliseconds(100);
+}
+
+void appExchange(SPIDriver& spi, uint8_t command) {
+	tx = {};
+	rx = {};
+	tx.bytes[0] = command;
+	wire::seal(tx);
+	spiSelect(&spi);
+	spiExchange(&spi, wire::appFrameSize, tx.bytes, rx.bytes);
+	spiUnselect(&spi);
+	chThdSleepMilliseconds(2);
+}
+
+bool versionMatches(SPIDriver& spi) {
+	appExchange(spi, wire::cmdReadVersion);
+	appExchange(spi, wire::cmdNop);
+	wire::AppFrame request = {};
+	request.bytes[0] = wire::cmdReadVersion;
+	return validResponse(request, rx) && rx.versionResponse.version == g0_image::version;
+}
+
+class Transport final : public BootTransport {
+public:
+	explicit Transport(SPIDriver& spi)
+		: m_spi(spi) {}
+	uint8_t byte(uint8_t value) override {
+		tx.bytes[0] = value;
+		spiExchange(&m_spi, 1, tx.bytes, rx.bytes);
+		chThdSleepMicroseconds(20);
+		return rx.bytes[0];
+	}
+	void sleepMs(uint32_t delay) override {
+		chThdSleepMilliseconds(delay);
+	}
+
+private:
+	SPIDriver& m_spi;
+};
+} // namespace
+
+bool updateFirmware(SPIDriver& spi, const SPIConfig& spiSettings, brain_pin_e resetPin, brain_pin_e bootPin) {
+	// Reject an invalid image before touching reset or entering the ROM loader.
+	if (!Bootloader::validImage(g0_image::data, sizeof(g0_image::data))) {
+		return false;
+	}
+	efiSetPadMode("G0 BOOT", bootPin, PAL_MODE_OUTPUT_PUSHPULL);
+	efiSetPadMode("G0 RESET", resetPin, PAL_MODE_OUTPUT_PUSHPULL);
+	spiAcquireBus(&spi);
+	spiStart(&spi, &spiSettings);
+	reset(resetPin, bootPin, false);
+	bool ok = versionMatches(spi);
+	if (!ok) {
+		efiPrintf("G0: programming bundled firmware");
+		reset(resetPin, bootPin, true);
+		spiSelect(&spi);
+		Transport transport(spi);
+		Bootloader loader(transport);
+		ok = loader.flash(g0_image::data, sizeof(g0_image::data));
+		spiUnselect(&spi);
+		reset(resetPin, bootPin, false);
+		ok = ok && versionMatches(spi);
+	}
+	spiStop(&spi);
+	spiReleaseBus(&spi);
+	// Retain ownership: these are dedicated expansion control pins.
+	pin(bootPin, false);
+	pin(resetPin, true);
+	efiPrintf("G0 firmware %s", ok ? "ready" : "failed");
+	return ok;
+}
+} // namespace g0
