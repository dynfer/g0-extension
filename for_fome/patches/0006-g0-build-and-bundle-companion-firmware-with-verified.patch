diff --git a/firmware/hw_layer/g0_extension/image.mk b/firmware/hw_layer/g0_extension/image.mk
new file mode 100644
index 0000000000..b8ad81eef4
--- /dev/null
+++ b/firmware/hw_layer/g0_extension/image.mk
@@ -0,0 +1,33 @@
+# Included by the main firmware Makefile after the ChibiOS object list exists.
+# The ECU bootloader, simulator, and native tests do not bundle this image.
+ifeq ($(G0_EXTENSION),yes)
+ifeq ($(G0_FIRMWARE_UPDATE),yes)
+G0_FIRMWARE_DIR := $(PROJECT_DIR)/ext/g0_firmware
+G0_FIRMWARE_BUILD := $(abspath $(BUILDDIR)/g0_firmware)
+G0_FIRMWARE_IMAGE := $(G0_FIRMWARE_BUILD)/g0-extension.bin
+G0_FIRMWARE_HEADER := $(GENERATED_DIR)/g0_firmware_image.h
+G0_IMAGE_GENERATOR := $(PROJECT_DIR)/hw_layer/g0_extension/make_image.py
+G0_COMPILER_PREFIX := $(abspath $(TRGT))
+PYTHON ?= python3
+
+# Let the nested make inspect its own dependencies on every invocation. Keep its
+# objects outside the submodule and use the same pinned ARM compiler as fome-fw.
+.PHONY: g0-firmware
+g0-firmware:
+	git -C "$(PROJECT_DIR)/.." submodule update --init --recursive -- firmware/ext/g0_firmware
+	+$(MAKE) -C "$(G0_FIRMWARE_DIR)" all \
+		TRGT="$(G0_COMPILER_PREFIX)" \
+		BUILDDIR="$(G0_FIRMWARE_BUILD)" DEPDIR="$(G0_FIRMWARE_BUILD)/.dep" \
+		USE_OPT="-Os -ggdb -fomit-frame-pointer -falign-functions=16 --specs=nosys.specs"
+
+$(G0_FIRMWARE_HEADER): g0-firmware $(G0_IMAGE_GENERATOR)
+	$(PYTHON) "$(G0_IMAGE_GENERATOR)" \
+		--input "$(G0_FIRMWARE_IMAGE)" --output "$@" \
+		--version-header "$(G0_FIRMWARE_BUILD)/g0_firmware_version.h"
+
+# Missing headers after clean and fresh parallel builds take the same path.
+# make_image.py preserves the mtime when the image has not changed, so the normal
+# compiler dependency on this header only rebuilds the updater for a new image.
+$(OBJS) $(PCHOBJ): | $(G0_FIRMWARE_HEADER)
+endif
+endif
diff --git a/firmware/hw_layer/g0_extension/make_image.py b/firmware/hw_layer/g0_extension/make_image.py
new file mode 100644
index 0000000000..7dd78074f8
--- /dev/null
+++ b/firmware/hw_layer/g0_extension/make_image.py
@@ -0,0 +1,38 @@
+#!/usr/bin/env python3
+"""Create an immutable bundled image from an explicitly selected STM32G071 binary."""
+import argparse
+import hashlib
+from pathlib import Path
+import re
+import struct
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--input", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--version-header", type=Path, required=True)
+    args = parser.parse_args()
+    versions = re.findall(r"^#define G0_FIRMWARE_VERSION (0x[0-9a-fA-F]+|[0-9]+)U?$",
+                          args.version_header.read_text(), re.MULTILINE)
+    if len(versions) != 1:
+        parser.error("expected exactly one G0_FIRMWARE_VERSION in --version-header")
+    image_version = int(versions[0], 0)
+    data = args.input.read_bytes()
+    if not 8 <= len(data) <= 128 * 1024 or not 0 < image_version <= 0xFFFFFFFF:
+        parser.error("expected a nonzero 32-bit firmware identity and an 8..131072 byte image")
+    sp, entry = struct.unpack_from("<II", data)
+    if not (0x20000000 < sp <= 0x20009000 and sp % 8 == 0 and entry & 1
+            and 0x08000008 <= (entry & ~1) < 0x08000000 + len(data)):
+        parser.error("invalid STM32G071 application vectors")
+    rows = [", ".join(f"0x{value:02x}" for value in data[i:i + 16]) for i in range(0, len(data), 16)]
+    content = (f"// SHA256: {hashlib.sha256(data).hexdigest()}\n#pragma once\n"
+               f"namespace g0_image {{\nstatic constexpr unsigned version = {image_version};\n"
+               "static const unsigned char data[] = {\n" + ",\n".join(rows) + "\n};\n}\n")
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    if not args.output.exists() or args.output.read_text() != content:
+        temporary = args.output.with_suffix(args.output.suffix + ".tmp")
+        temporary.write_text(content)
+        temporary.replace(args.output)
+
+if __name__ == "__main__":
+    main()
