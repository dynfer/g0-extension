From: dynfer <denesius20@gmail.com>
Date: Wed, 18 Nov 2026 22:06:49 +0100
Subject: [PATCH 2/2] build: package firmware with the selected ARM binutils

---
 firmware/CHANGELOG.md                         |  1 +
 .../config/boards/write_firmware_checksum.sh  | 15 ++--
 firmware/tests/test_checksum_tools.py         | 74 +++++++++++++++++++
 firmware/use_arm_gcc.mk                       |  7 ++
 4 files changed, 91 insertions(+), 6 deletions(-)
 create mode 100644 firmware/tests/test_checksum_tools.py

diff --git a/firmware/CHANGELOG.md b/firmware/CHANGELOG.md
index 2ac90fe5f2..c6f964821c 100644
--- a/firmware/CHANGELOG.md
+++ b/firmware/CHANGELOG.md
@@ -70,6 +70,7 @@ or
  - Instant RPM is now used automatically on triggers with 24 or more teeth per engine cycle (a 12 tooth crank wheel or better), instead of only when "Always use instant RPM" was enabled. RPM, and everything derived from it, now responds within a fraction of an engine cycle instead of once per cycle. The setting remains, and now forces instant RPM on triggers with fewer teeth than that.
 
 ### Fixed
+ - Package firmware with the selected ARM toolchain instead of host objcopy/objdump.
  - Regenerate enum names and missing generated headers before compilation when cached generation stamps survive a pull or another build directory is cleaned.
  - Release G0 BOOT0 after initialization so its shared SWCLK pin remains available to a debugger while the ECU runs.
  - G0 PWM accepts paused frequency values used by tachometer/speedometer outputs and follows the global PWM enable setting.
diff --git a/firmware/config/boards/write_firmware_checksum.sh b/firmware/config/boards/write_firmware_checksum.sh
index 2cf374bbb7..be2dc9b9eb 100755
--- a/firmware/config/boards/write_firmware_checksum.sh
+++ b/firmware/config/boards/write_firmware_checksum.sh
@@ -2,7 +2,7 @@
 
 # Read an elf image, then write .hex/.srec files with checksum added
 
-set -e
+set -eo pipefail
 
 # Input: An elf file to checksum
 INPUT_FILE=$1
@@ -10,8 +10,11 @@ INPUT_FILE=$1
 # Output: Srec file name
 OUTPUT_FILE=$2
 
+FW_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
+ARM_PREFIX=$(make --no-print-directory -s -C "$FW_DIR" -f use_arm_gcc.mk PROJECT_DIR=. print-arm-toolchain | tail -n 1)
+
 # Extract the firmware's base address from the elf - it may be different depending on exact CPU
-firmwareBaseAddress="$(objdump -h -j .vectors $INPUT_FILE | awk '/.vectors/ {print $5 }')"
+firmwareBaseAddress="$("${ARM_PREFIX}objdump" -h -j .vectors "$INPUT_FILE" | awk '/.vectors/ {print $5 }')"
 echo "$INPUT_FILE Base address is 0x$firmwareBaseAddress"
 
 # Offset the checksum's location at 0x1C past the base
@@ -19,12 +22,12 @@ checksumAddress="$(printf "%X\n" $((0x$firmwareBaseAddress+0x1c)))"
 echo "$INPUT_FILE Checksum address is 0x$checksumAddress"
 
 # Make a temporary hex that hex2dfu can read
-objcopy -O ihex $INPUT_FILE temp.hex
+"${ARM_PREFIX}objcopy" -O ihex "$INPUT_FILE" temp.hex
 
 # Add the checksum
-$HEX2DFU -i temp.hex -c $checksumAddress -b $OUTPUT_FILE.bin
+"$HEX2DFU" -i temp.hex -c "$checksumAddress" -b "$OUTPUT_FILE.bin"
 rm temp.hex
 
 # re-make hex, srec with the checksum in place
-objcopy -I binary -O ihex --change-addresses=0x$firmwareBaseAddress $OUTPUT_FILE.bin $OUTPUT_FILE.hex
-objcopy -I binary -O srec --change-addresses=0x$firmwareBaseAddress $OUTPUT_FILE.bin $OUTPUT_FILE.srec
+"${ARM_PREFIX}objcopy" -I binary -O ihex --change-addresses="0x$firmwareBaseAddress" "$OUTPUT_FILE.bin" "$OUTPUT_FILE.hex"
+"${ARM_PREFIX}objcopy" -I binary -O srec --change-addresses="0x$firmwareBaseAddress" "$OUTPUT_FILE.bin" "$OUTPUT_FILE.srec"
diff --git a/firmware/tests/test_checksum_tools.py b/firmware/tests/test_checksum_tools.py
new file mode 100644
index 0000000000..9270c16c2b
--- /dev/null
+++ b/firmware/tests/test_checksum_tools.py
@@ -0,0 +1,74 @@
+"""Check that packaging uses selected ARM tools and propagates selection failures."""
+import json
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+
+FIRMWARE = Path(__file__).resolve().parents[1]
+SCRIPT = FIRMWARE / 'config/boards/write_firmware_checksum.sh'
+
+
+class ChecksumToolsTest(unittest.TestCase):
+    def test_tools_and_selection_failure(self):
+        with tempfile.TemporaryDirectory(prefix='arm tools ') as tmp:
+            root = Path(tmp)
+            shim = root / 'shim'
+            shim.mkdir()
+            prefix = root / 'arm-'
+            program = '''#!/usr/bin/python3
+import json, os, pathlib, sys
+name = pathlib.Path(sys.argv[0]).name
+with open(os.environ['TEST_TOOL_LOG'], 'a') as log:
+ log.write(json.dumps([name, sys.argv[1:]]) + '\\n')
+if name == 'make':
+ if os.environ.get('TEST_MAKE_FAIL'): sys.exit(7)
+ print('toolchain diagnostic')
+ print(os.environ['TEST_ARM_PREFIX'])
+elif name == 'arm-objdump':
+ print('0 .vectors 000002a0 08020000 08020000 00010000 2**4')
+elif name in ('objcopy', 'objdump'):
+ sys.exit(99)
+elif name == 'hex2dfu':
+ pathlib.Path(sys.argv[sys.argv.index('-b')+1]).touch()
+else:
+ pathlib.Path(sys.argv[-1]).touch()
+'''
+            for path in [shim / 'make', shim / 'objcopy', shim / 'objdump',
+                         root / 'arm-objcopy', root / 'arm-objdump', root / 'hex2dfu']:
+                path.write_text(program)
+                path.chmod(0o755)
+            log = root / 'calls.jsonl'
+            env = dict(os.environ, PATH=str(shim)+':/usr/bin:/bin',
+                       HEX2DFU=str(root / 'hex2dfu'), TEST_TOOL_LOG=str(log),
+                       TEST_ARM_PREFIX=str(prefix))
+            result = subprocess.run(['bash', str(SCRIPT), 'input elf', 'output file'],
+                                    cwd=root, env=env, capture_output=True, text=True)
+            self.assertEqual(result.returncode, 0, result.stderr)
+            calls = [json.loads(line) for line in log.read_text().splitlines()]
+            self.assertEqual([call[0] for call in calls],
+                             ['make', 'arm-objdump', 'arm-objcopy', 'hex2dfu',
+                              'arm-objcopy', 'arm-objcopy'])
+            self.assertIn('802001C', calls[3][1])
+            self.assertTrue((root / 'output file.srec').exists())
+            env['TEST_MAKE_FAIL'] = '1'
+            log.unlink()
+            result = subprocess.run(['bash', str(SCRIPT), 'input elf', 'output file'],
+                                    cwd=root, env=env, capture_output=True, text=True)
+            self.assertNotEqual(result.returncode, 0)
+            self.assertEqual(len(log.read_text().splitlines()), 1)
+
+    def test_custom_toolchain_query(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            prefix = Path(tmp) / 'cross-'
+            Path(str(prefix)+'g++').touch()
+            result = subprocess.run(
+                ['make', '-s', '-f', 'use_arm_gcc.mk', 'PROJECT_DIR=.',
+                 'TRGT='+str(prefix), 'print-arm-toolchain'], cwd=FIRMWARE,
+                check=True, capture_output=True, text=True)
+            self.assertEqual(result.stdout.splitlines()[-1], str(prefix))
+
+
+if __name__ == '__main__':
+    unittest.main()
diff --git a/firmware/use_arm_gcc.mk b/firmware/use_arm_gcc.mk
index 919bf31e8d..27ab4a6266 100644
--- a/firmware/use_arm_gcc.mk
+++ b/firmware/use_arm_gcc.mk
@@ -28,3 +28,10 @@ endif
 
 $(info COMPILER_PLATFORM: $(COMPILER_PLATFORM))
 $(info TRGT:              $(TRGT))
+
+# Packaging scripts query the same toolchain selection without loading a board build.
+ifneq ($(filter print-arm-toolchain,$(MAKECMDGOALS)),)
+.PHONY: print-arm-toolchain
+print-arm-toolchain:
+	@printf '%s\n' "$(abspath $(TRGT))"
+endif
