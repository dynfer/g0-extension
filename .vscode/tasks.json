{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "make",
      "type": "shell",
      "command": "make",
      "args": [
        "-j"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "flash",
      "type": "shell",
      "command": "openocd",
      "args": [
        "-f",
        "interface/stlink.cfg",
        "-f",
        "target/stm32g0x.cfg",
        "-c",
        "program ${workspaceFolder}/build/g0-extension.elf verify reset exit"
      ],
      "dependsOn": "make",
      "problemMatcher": []
    }
  ]
}
